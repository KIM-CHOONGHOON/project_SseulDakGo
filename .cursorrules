('APPLIANCE_SPEC_UNIT', '가전 규격 측정 단위',          'Y', '평형, Kg, L, 구, 침대사이즈',                   NOW(), 'SYSTEM', NOW(), 'SYSTEM'),
('AIRCON_PYEONG',       '에어컨 표준 평형 선택 목록',   'Y', '에어컨 평형 콤보박스 선택지 (6평~30평)',         NOW(), 'SYSTEM', NOW(), 'SYSTEM'),
