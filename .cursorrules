DROP TABLE IF EXISTS TB_SYS_POLICY_CONFIG;
CREATE TABLE TB_SYS_POLICY_CONFIG (
    POLICY_KEY          VARCHAR(50)     NOT NULL    COMMENT '정책 식별 키',
    POLICY_NM           VARCHAR(100)    NOT NULL    COMMENT '정책 명칭',
    POLICY_VAL          VARCHAR(255)    NOT NULL    COMMENT '설정 값',
    DATA_TYPE           VARCHAR(20)     NOT NULL DEFAULT 'STRING',
    POLICY_DESC         VARCHAR(500)    NULL        COMMENT '설명',
    USE_YN              CHAR(1)         NOT NULL DEFAULT 'Y',
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    REG_ID              VARCHAR(50)     NOT NULL DEFAULT 'SYSTEM',
    MOD_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    MOD_ID              VARCHAR(50)     NOT NULL DEFAULT 'SYSTEM',
    CONSTRAINT PK_TB_SYS_POLICY_CONFIG PRIMARY KEY (POLICY_KEY)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='시스템 운영 정책 파라미터';

DROP TABLE IF EXISTS TB_USER;
CREATE TABLE TB_USER (
    USER_NO             CHAR(12)        NOT NULL    COMMENT '사용자 번호 (C/S/A + YYYYMM + 5자리)',
    USER_ROLE_CD        CHAR(1)         NOT NULL    COMMENT '회원 구분: C(고객), S(용역), A(관리)',
    USER_EMAIL          VARCHAR(100)    NOT NULL    COMMENT '로그인 이메일 주소',
    USER_PWD_HASH       VARCHAR(255)    NULL        COMMENT '비밀번호 해시',
    PWD_SALT            VARCHAR(64)     NULL        COMMENT '암호화 솔트',
    USER_NM             VARCHAR(50)     NOT NULL    COMMENT '실명 또는 담당자명',
    USER_TEL            VARCHAR(20)     NOT NULL    COMMENT '휴대폰 번호 (010-0000-0000)',
    SOCIAL_PROVIDER     VARCHAR(20)     NULL        COMMENT 'KAKAO, NAVER, GOOGLE, APPLE',
    SOCIAL_UID          VARCHAR(100)    NULL        COMMENT '소셜 고유 식별값',
    COMPANY_NM          VARCHAR(100)    NULL        COMMENT '상호/업체명 (용역 및 법인고객)',
    BIZ_NO              VARCHAR(20)     NULL        COMMENT '사업자등록번호 10자리 (용역회원 필수)',
    USER_STAT_CD        VARCHAR(20)     NOT NULL DEFAULT 'NORMAL' COMMENT 'NORMAL, SUSPENDED_7D, BLOCKED, WITHDRAWN',
    SUSPEND_EXPIRE_DT   DATETIME        NULL        COMMENT '선취소 7일 정지 만료 일시',
    ACTIVE_STATUS_YN    CHAR(1)         NOT NULL DEFAULT 'Y' COMMENT '영업 On/Off 상태 (용역 전용)',
    ALLIANCE_CD         VARCHAR(30)     NULL        COMMENT '유입 제휴사 코드 (제휴 가입자 트래킹)',
    LAST_LOGIN_DT       DATETIME        NULL,
    SIGN_IMG_URL        VARCHAR(500)    NULL        COMMENT '전자거래 서명패드 자필 전자서명 이미지 파일 웹 접근 URL', 
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    REG_ID              VARCHAR(50)     NOT NULL DEFAULT 'SYSTEM',
    MOD_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    MOD_ID              VARCHAR(50)     NOT NULL DEFAULT 'SYSTEM',
    CONSTRAINT PK_TB_USER PRIMARY KEY (USER_NO),
    CONSTRAINT UQ_ROLE_EMAIL UNIQUE (USER_ROLE_CD, USER_EMAIL),
    INDEX IDX_VERIFY_DUP (USER_TEL, USER_EMAIL, SOCIAL_PROVIDER, SOCIAL_UID)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='통합 사용자 마스터 테이블';

DROP TABLE IF EXISTS TB_SERVICE_REGION;
CREATE TABLE TB_SERVICE_REGION (
    REGION_SEQ          BIGINT AUTO_INCREMENT NOT NULL COMMENT '지역 설정 SEQ PK',
    USER_NO             CHAR(12)        NOT NULL    COMMENT '용역 회원번호 (S로 시작)',
    SIDO_CD             VARCHAR(20)     NOT NULL    COMMENT '시/도 코드',
    SIGUNGU_CD          VARCHAR(20)     NOT NULL    COMMENT '시/군/구 코드',
    REGION_NM           VARCHAR(100)    NOT NULL    COMMENT '지역 표기명 (예: 경기도 고양시 일산동구)',
    SORT_ORD            INT             NOT NULL DEFAULT 1 COMMENT '우선순위 (1~10)',
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT PK_TB_SERVICE_REGION PRIMARY KEY (REGION_SEQ),
    CONSTRAINT FK_REGION_USER FOREIGN KEY (USER_NO) REFERENCES TB_USER (USER_NO) ON DELETE CASCADE,
    CONSTRAINT UQ_USER_REGION UNIQUE (USER_NO, SIDO_CD, SIGUNGU_CD)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='용역 회원 서비스 가능 지역 (최대 10개)';

DROP TABLE IF EXISTS TB_SERVICE_DOC;
CREATE TABLE TB_SERVICE_DOC (
    DOC_SEQ             BIGINT AUTO_INCREMENT NOT NULL COMMENT '서류 일련번호 PK',
    SRVC_NO             CHAR(12)        NOT NULL    COMMENT '용역 회원 식별번호 (S로 시작)',
    DOC_KIND_CD         VARCHAR(30)     NOT NULL    COMMENT 'BIZ_CERT(사업자등록증), INSUR_CERT(보험증권), EQUIP_PHOTO(장비)',
    INPUT_METHOD_CD     VARCHAR(20)     NOT NULL DEFAULT 'FILE' COMMENT 'FILE: 파일업로드, CAMERA: 사진직접촬영',
    STORAGE_PATH        VARCHAR(300)    NOT NULL    COMMENT '저장 폴더 (/uploads/service/{SRVC_NO}/biz_docs/)',
    LOGICAL_FILE_NM     VARCHAR(200)    NOT NULL    COMMENT '업로드 원본 파일명',
    PHYSICAL_FILE_NM    VARCHAR(200)    NOT NULL    COMMENT '서버 저장 물리 파일명',
    FILE_EXT            VARCHAR(10)     NOT NULL    COMMENT '확장자 (PDF, JPG, PNG 등)',
    FILE_SIZE_BYTE      BIGINT          NOT NULL    COMMENT '파일 크기 (Byte)',
    OCR_ENGINE_CD       VARCHAR(30)     NULL        COMMENT 'OCR 엔진 (NCP_CLOVA, UPSTAGE)',
    OCR_RAW_JSON        LONGTEXT        NULL        COMMENT 'OCR 추출 JSON 원본 응답 전문',
    PARSED_BIZ_NO       VARCHAR(20)     NULL        COMMENT 'OCR 추출 사업자번호',
    PARSED_CORP_NM      VARCHAR(100)    NULL        COMMENT 'OCR 추출 상호명',
    PARSED_REP_NM       VARCHAR(50)     NULL        COMMENT 'OCR 추출 대표자명',
    PARSED_OPEN_DT      VARCHAR(8)      NULL        COMMENT 'OCR 추출 개업일자',
    PARSED_ADDR         VARCHAR(300)    NULL        COMMENT 'OCR 추출 사업장소재지',
    VERIFY_YN           CHAR(1)         NOT NULL DEFAULT 'N' COMMENT '국세청/통신사 진위 대조 통과 여부',
    VERIFY_FAIL_MSG     VARCHAR(255)    NULL        COMMENT '검증 실패 사유',
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    REG_ID              VARCHAR(50)     NOT NULL,
    CONSTRAINT PK_TB_SERVICE_DOC PRIMARY KEY (DOC_SEQ),
    CONSTRAINT FK_DOC_SRVC_NO FOREIGN KEY (SRVC_NO) REFERENCES TB_USER (USER_NO) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='용역 사업자등록증 원본 및 OCR 파싱 관리 원장';

DROP TABLE IF EXISTS TB_ORDER_MSTR;
CREATE TABLE TB_ORDER_MSTR (
    ORDER_NO            CHAR(16)        NOT NULL    COMMENT '주발주 관리번호 (ORD+YYYYMMDD+5자리)',
    CLIENT_USER_NO      CHAR(12)        NOT NULL    COMMENT '발주 고객 회원번호 (C로 시작, FK)',
    ORDER_STATUS        VARCHAR(20)     NOT NULL DEFAULT 'BID_OPEN' COMMENT 'ORD_REG, BID_OPEN, CNTR_CONFIRMED, SVC_PROGRESS, SVC_COMPLETED, SETTL_COMPLETED, BID_EXPIRED, ORD_CANCEL',
    PROPOSED_PRICE      INT             NOT NULL    COMMENT '고객 확정 지정 청소 대금 (역경매 불가 고정금액)',
    COMPANY_OR_ORG_NM   VARCHAR(100)    NULL        COMMENT '의뢰 업체·기관명',
    CONTACT_PERSON_NM   VARCHAR(50)     NOT NULL    COMMENT '현장 담당자명',
    CONTACT_TEL         VARCHAR(20)     NOT NULL    COMMENT '현장 담당자 연락처',
    CONTACT_EMAIL       VARCHAR(100)    NULL        COMMENT '담당자 이메일',
    FACILITY_TYPE_CD    VARCHAR(30)     NOT NULL DEFAULT 'OFFICE' COMMENT '시설 유형 (사무실, 상가, 학교 등)',
    PARKING_AVAIL_CD    VARCHAR(20)     NOT NULL DEFAULT 'YES' COMMENT '주차 여부 (YES, NO, UNKNOWN)',
    SIDO_CD             VARCHAR(20)     NOT NULL    COMMENT '시/도 코드',
    SIGUNGU_CD          VARCHAR(20)     NOT NULL    COMMENT '시/군/구 코드',
    ADDR_TEXT           VARCHAR(200)    NOT NULL    COMMENT '기본 현장 주소 (동/리 노출용)',
    ADDR_DETAIL         VARCHAR(200)    NULL        COMMENT '상세 주소 (체결 후 용역에 공개)',
    DETAIL_REQ_NOTE     TEXT            NULL        COMMENT '상세 요청사항',
    ALLIANCE_CD         VARCHAR(30)     NULL        COMMENT '유입 제휴사 코드 (제휴 발주 트래킹)',
    BID_EXPIRE_DT       DATETIME        NOT NULL    COMMENT '청약 만료 일시 (발주일 + 7일)',
    CONFIRMED_DT        DATETIME        NULL        COMMENT '계약 확정 일시',
    COMPLETED_DT        DATETIME        NULL        COMMENT '청소 완료 일시',
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    MOD_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT PK_TB_ORDER_MSTR PRIMARY KEY (ORDER_NO),
    CONSTRAINT FK_ORD_CLIENT FOREIGN KEY (CLIENT_USER_NO) REFERENCES TB_USER (USER_NO),
    INDEX IDX_ORD_STATUS_EXPIRE (ORDER_STATUS, BID_EXPIRE_DT)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='주발주 마스터 테이블';

DROP TABLE IF EXISTS TB_ORDER_APPLIANCE_ITEM;
DROP TABLE IF EXISTS TB_ORDER_DTL;
CREATE TABLE TB_ORDER_DTL (
    ORDER_DTL_NO            CHAR(18)        NOT NULL    COMMENT '발주 상세번호 (PK: ORDER_NO 16자리 + 순번 2자리, 예: ORD202611010000101)',
    ORDER_NO                CHAR(16)        NOT NULL    COMMENT '주발주 관리번호 (TB_ORDER_MSTR FK)',
    CLEAN_LARGE_CD          VARCHAR(30)     NOT NULL    COMMENT '청소 대분류 코드 (REGULAR: 정기청소, MOVEIN: 입주이사, APPLIANCE: 계절가전)',
    CLEAN_MID_CD            VARCHAR(30)     NOT NULL    COMMENT '청소 중분류 대표 코드 (APPLIANCE_ALL, AIRCON, WASHER, KITCHEN_LIVING 등)',
    SERVICE_STATUS          VARCHAR(20)     NOT NULL DEFAULT 'WAIT_BID' COMMENT '시공 상태 (WAIT_BID: 대기, APPR_CONTRACT: 체결, WAIT_CLOSED: 마감, BID_REJECTED: 반려)',
    CONTRACT_TYPE_CD        VARCHAR(20)     NOT NULL DEFAULT '1회성 단독 시공' COMMENT '계약 형태 (1회성 단독 시공, 정기 용역 계약)',
    SELECTED_SRV_ITEMS      VARCHAR(500)    NULL        COMMENT '선택된 필요 서비스 코드 목록 (콤마 구분 문자열)',
    -- 정기 및 입주청소 호환 컬럼
    CONTRACT_TERM_DAYS      INT             NULL DEFAULT 90 COMMENT '정기청소 90일 락 일수',
    WEEK_CLEAN_FREQ         INT             NULL DEFAULT 1  COMMENT '주간 방문 횟수 (1, 2, 3, 5회)',
    CLEAN_DAYS_CONFIG       VARCHAR(50)     NULL        COMMENT '방문 희망 요일 (예: MON,WED,FRI)',
    SERVICE_START_DT        DATE            NOT NULL    COMMENT '희망 작업 시작일 (From)',
    SERVICE_END_DT          DATE            NULL        COMMENT '희망 작업 종료일 (To)',
    SUPPLY_PYEONG           DECIMAL(5,1)    NULL        COMMENT '입주/이사청소 실평수/공급평수',
    -- [계절가전청소 특화 마스터 컬럼]
    APPLIANCE_TOTAL_CNT     INT             NOT NULL DEFAULT 0 COMMENT '계절가전 총 의뢰 기기 대수 합계',
    AIRCON_TOTAL_CNT        INT             NOT NULL DEFAULT 0 COMMENT '에어컨 전체 총 대수 합계',
    WASHER_TOTAL_CNT        INT             NOT NULL DEFAULT 0 COMMENT '세탁기 전체 총 대수 합계',
    KITCHEN_TOTAL_CNT       INT             NOT NULL DEFAULT 0 COMMENT '주방 및 생활가전 전체 총 개수 합계',
    WORK_TIME_SLOT          VARCHAR(50)     NULL        COMMENT '희망 작업 시간대 (예: 오전 08:00 ~ 오후 05:00, 시공사와 협의 가능)',
    -- 배정 및 감사 컬럼
    SELECTED_SERVICE_USER_NO CHAR(12)       NULL        COMMENT '최종 확정 배정된 시공사 회원번호 (S로 시작)',
    REG_DT                  DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '최초 등록 일시',
    REG_ID                  VARCHAR(50)     NOT NULL DEFAULT 'CLIENT' COMMENT '최초 등록자 식별자',
    MOD_DT                  DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '최종 수정 일시',
    MOD_ID                  VARCHAR(50)     NOT NULL DEFAULT 'CLIENT' COMMENT '최종 수정자 식별자',
    CONSTRAINT PK_TB_ORDER_DTL PRIMARY KEY (ORDER_DTL_NO),
    CONSTRAINT FK_DTL_ORD FOREIGN KEY (ORDER_NO) REFERENCES TB_ORDER_MSTR (ORDER_NO) ON DELETE CASCADE,
    INDEX IDX_DTL_LARGE_STATUS (CLEAN_LARGE_CD, SERVICE_STATUS)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='발주 서비스 상세 및 계절가전 마스터 원장';
-- ============================================================================
-- [테이블 2] TB_ORDER_APPLIANCE_ITEM (계절가전 개별 품목 목록 원장)
-- ※ 에어컨/세탁기/냉장고/후드/매트리스 대수가 늘어난 만큼 1기기당 1개 Row로 개별 분리 저장
-- ============================================================================
CREATE TABLE TB_ORDER_APPLIANCE_ITEM (
    APPLIANCE_ITEM_ID       BIGINT AUTO_INCREMENT NOT NULL COMMENT '가전 개별 품목 고유 식별 일련번호 (PK)',
    ORDER_DTL_NO            CHAR(18)        NOT NULL    COMMENT '발주 상세번호 (TB_ORDER_DTL FK)',
    ORDER_NO                CHAR(16)        NOT NULL    COMMENT '주발주 관리번호 (TB_ORDER_MSTR FK)',
    -- 1. 가전 분류 및 품목 종류
    APPLIANCE_CAT_CD        VARCHAR(30)     NOT NULL    COMMENT '가전 대분류 코드 (AIRCON: 에어컨, WASHER: 세탁기, KITCHEN_LIVING: 주방·생활가전)',
    APPLIANCE_TYPE_CD       VARCHAR(30)     NOT NULL    COMMENT '가전 품목 상세 코드 (WALL_MOUNTED: 벽걸이형, STAND: 스탠드형, CEILING_SYS: 천장형시스템, TUB_WASHER: 일반통돌이, DRUM_WASHER: 드럼세탁기, FRIDGE_STEAM: 냉장고스팀, RANGE_HOOD: 레인지후드, MATTRESS: 매트리스살균)',
    ITEM_SEQ_NO             INT             NOT NULL DEFAULT 1 COMMENT '동일 품목 내 기기 순번 (예: 벽걸이 1호기=1, 벽걸이 2호기=2)',
    ITEM_NM                 VARCHAR(50)     NOT NULL    COMMENT '표시 품목 명칭 (예: 벽걸이형 에어컨, 드럼 세탁기, 냉장고 스팀, 매트리스 살균)',
    -- 2. 개별 기기별 규격 입력값 보관 (대수만큼 각각 입력된 평형 / Kg / 리터 / 구 수 / 침대크기)
    SPEC_UNIT_CD            VARCHAR(20)     NOT NULL    COMMENT '규격 단위 코드 (PYEONG: 평형, KG: 킬로그램, LITER: 리터, BURNER_CNT: 화구 수, MATTRESS_SIZE: 매트리스 크기)',
    SPEC_NUM_VAL            DECIMAL(7,1)    NULL        COMMENT '규격 수치 숫자값 (예: 6.0, 18.0, 15.0, 850.0, 3.0)',
    SPEC_TEXT_VAL           VARCHAR(50)     NOT NULL    COMMENT '고객 입력 최종 규격 텍스트 (예: 6평, 18평, 15kg, 850L, 3구, 퀸(Q), 킹(K) 등)',
    -- 3. 매트리스 전용 공통코드 매핑
    MATTRESS_SIZE_CD        VARCHAR(20)     NULL        COMMENT '매트리스 규격 공통코드 (SINGLE, SUPER_SINGLE, DOUBLE, QUEEN, KING, SUPER_KING, CUSTOM)',
    -- 4. 기기 부가 정보 및 현장 설치 위치
    INSTALL_LOC_DESC        VARCHAR(100)    NULL        COMMENT '기기 설치 위치 (예: 안방, 거실, 아이방, 다용도실 등)',
    BRAND_NM                VARCHAR(50)     NULL        COMMENT '제조사 브랜드 (선택 입력: 삼성, LG, 캐리어 등)',
    HIGH_PRESSURE_YN        CHAR(1)         NOT NULL DEFAULT 'Y' COMMENT '냉각핀/세탁조 완전분해 고압살균 세척 여부 (Y/N)',
    STEAM_STERILIZE_YN      CHAR(1)         NOT NULL DEFAULT 'Y' COMMENT '고온 스팀 살균 케어 여부 (Y/N)',
    -- 5. 개별 품목 시공 진행 상태
    ITEM_STATUS             VARCHAR(20)     NOT NULL DEFAULT 'WAIT' COMMENT '개별 기기 시공 상태 (WAIT: 대기, PROGRESS: 분해세척중, DONE: 완료)',
    WORKER_NOTE             VARCHAR(300)    NULL        COMMENT '시공사 기사 현장 특이사항 및 세척 소견 메모',
    -- 6. 등록 및 수정 감사 컬럼
    REG_DT                  DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '최초 등록 일시',
    REG_ID                  VARCHAR(50)     NOT NULL DEFAULT 'CLIENT' COMMENT '최초 등록자',
    MOD_DT                  DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '최종 수정 일시',
    MOD_ID                  VARCHAR(50)     NOT NULL DEFAULT 'CLIENT' COMMENT '최종 수정자',
    CONSTRAINT PK_TB_ORDER_APPLIANCE_ITEM PRIMARY KEY (APPLIANCE_ITEM_ID),
    CONSTRAINT FK_APPLIANCE_TO_DTL FOREIGN KEY (ORDER_DTL_NO) REFERENCES TB_ORDER_DTL (ORDER_DTL_NO) ON DELETE CASCADE,
    CONSTRAINT FK_APPLIANCE_TO_MSTR FOREIGN KEY (ORDER_NO) REFERENCES TB_ORDER_MSTR (ORDER_NO) ON DELETE CASCADE,
    INDEX IDX_APPLIANCE_DTL_TYPE (ORDER_DTL_NO, APPLIANCE_TYPE_CD),
    INDEX IDX_APPLIANCE_ORD (ORDER_NO)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='계절가전 분해살균 개별 기기 품목 및 규격 목록 원장';
DROP TABLE IF EXISTS TB_ORDER_PHOTO;
CREATE TABLE TB_ORDER_PHOTO (
    PHOTO_SEQ           BIGINT AUTO_INCREMENT NOT NULL COMMENT '사진 SEQ PK',
    ORDER_NO            CHAR(16)        NOT NULL    COMMENT '주발주 관리번호 (FK)',
    ORDER_DTL_NO        CHAR(18)        NOT NULL    COMMENT '발주 상세번호 (FK)',
    CLEAN_LARGE_CD      VARCHAR(30)     NOT NULL    COMMENT 'REGULAR, MOVEIN, APPLIANCE',
    PHOTO_TIMING_CD     VARCHAR(10)     NOT NULL    COMMENT 'BEFORE(작업전), AFTER(작업후)',
    STORAGE_PATH        VARCHAR(300)    NOT NULL    COMMENT '물리 경로 (/orders/{ORDER_NO}/{서비스종류}/{before,after}/)',
    LOGICAL_FILE_NM     VARCHAR(200)    NOT NULL    COMMENT '업로드 원본 파일명',
    PHYSICAL_FILE_NM    VARCHAR(200)    NOT NULL    COMMENT '서버 저장 UUID 파일명',
    FILE_EXT            VARCHAR(10)     NOT NULL    COMMENT '확장자 (JPG, PNG 등)',
    FILE_SIZE_BYTE      BIGINT          NOT NULL    COMMENT '크기 (Byte)',
    SORT_ORD            INT             NOT NULL DEFAULT 1,
    DEL_YN              CHAR(1)         NOT NULL DEFAULT 'N',
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    REG_ID              VARCHAR(50)     NOT NULL,
    CONSTRAINT PK_TB_ORDER_PHOTO PRIMARY KEY (PHOTO_SEQ),
    CONSTRAINT FK_PHOTO_ORD FOREIGN KEY (ORDER_NO) REFERENCES TB_ORDER_MSTR (ORDER_NO) ON DELETE CASCADE,
    CONSTRAINT FK_PHOTO_DTL FOREIGN KEY (ORDER_DTL_NO) REFERENCES TB_ORDER_DTL (ORDER_DTL_NO) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='청소 전/후 현장 사진 메타데이터 원장';

DROP TABLE IF EXISTS TB_QUOTE_APPLY;
CREATE TABLE TB_QUOTE_APPLY (
    APPLY_NO            CHAR(18)        NOT NULL    COMMENT '청약 번호 (APP+YYYYMMDD+5자리)',
    ORDER_NO            CHAR(16)        NOT NULL    COMMENT '주발주 관리번호 (FK)',
    ORDER_DTL_NO        CHAR(18)        NOT NULL    COMMENT '발주 상세번호 (FK)',
    SERVICE_USER_NO     CHAR(12)        NOT NULL    COMMENT '청약 용역 회원번호 (S로 시작, FK)',
    PROPOSED_DATE       DATE            NOT NULL    COMMENT '용역회원 시공 제안 일자 (From-To 범위 내)',
    TIME_SLOT_TYPE      VARCHAR(20)     NOT NULL    COMMENT 'ALL_DAY(종일), MORNING(오전), AFTERNOON(오후)',
    START_TIME          CHAR(5)         NOT NULL    COMMENT '시작 시각 (HH:mm)',
    WORK_HOURS          DECIMAL(4, 1)   NOT NULL    COMMENT '예상 소요 시간 (N시간)',
    ASSIGN_STAFF_CNT    INT             NOT NULL DEFAULT 1 COMMENT '투입 인원수',
    APPEAL_MSG          TEXT            NOT NULL    COMMENT '작업 계획 및 장비 어필 메시지',
    APPLY_STAT_CD       VARCHAR(20)     NOT NULL DEFAULT 'APPLIED' COMMENT 'APPLIED, ACCEPTED, REJECTED',
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    REG_ID              VARCHAR(50)     NOT NULL,
    MOD_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    MOD_ID              VARCHAR(50)     NOT NULL,
    CONSTRAINT PK_TB_QUOTE_APPLY PRIMARY KEY (APPLY_NO),
    CONSTRAINT FK_APPLY_ORD FOREIGN KEY (ORDER_NO) REFERENCES TB_ORDER_MSTR (ORDER_NO),
    CONSTRAINT FK_APPLY_DTL FOREIGN KEY (ORDER_DTL_NO) REFERENCES TB_ORDER_DTL (ORDER_DTL_NO),
    CONSTRAINT FK_APPLY_USER FOREIGN KEY (SERVICE_USER_NO) REFERENCES TB_USER (USER_NO),
    INDEX IDX_SCHEDULE_CHECK (SERVICE_USER_NO, PROPOSED_DATE, START_TIME, APPLY_STAT_CD)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='용역 청약서 원장 (역경매 금액 입력 없음, 일정 및 인원 제안 전용)';

DROP TABLE IF EXISTS TB_CLEAN_CONTRACT;
CREATE TABLE TB_CLEAN_CONTRACT (
    CONTRACT_NO         CHAR(16)        NOT NULL    COMMENT '계약 번호 (CNT+YYYYMMDD+5자리)',
    ORDER_NO            CHAR(16)        NOT NULL    COMMENT '주발주 관리번호 (FK)',
    ORDER_DTL_NO        CHAR(18)        NOT NULL    COMMENT '확정 중분류 상세번호 (FK)',
    CLIENT_USER_NO      CHAR(12)        NOT NULL    COMMENT '고객 회원번호 (FK)',
    SERVICE_USER_NO     CHAR(12)        NOT NULL    COMMENT '용역 회원번호 (FK)',
    APPLY_NO            CHAR(18)        NOT NULL    COMMENT '채택된 청약 번호 (FK)',
    CONFIRMED_DATE      DATE            NOT NULL    COMMENT '최종 확정 시공일',
    CONFIRMED_TIME      CHAR(5)         NOT NULL    COMMENT '최종 확정 시작시각 (HH:mm)',
    TOTAL_SERVICE_AMT   INT             NOT NULL    COMMENT '고객 확정 지정 용역 대금 (현장 직불)',
    CLIENT_FEE_AMT      INT             NOT NULL DEFAULT 16500 COMMENT '고객 고정 이용료 (16,500원)',
    SERVICE_FEE_AMT     INT             NOT NULL    COMMENT '용역 구간별 이용료 (1.65만/3.3만/11만/33만)',
    CLIENT_PAID_YN      CHAR(1)         NOT NULL DEFAULT 'N',
    SERVICE_PAID_YN     CHAR(1)         NOT NULL DEFAULT 'N',
    SAFE_TEL_NO         VARCHAR(20)     NULL        COMMENT '0507 안심번호',
    CONTRACT_STAT_CD    VARCHAR(20)     NOT NULL DEFAULT 'WAITING_PAY' COMMENT 'WAITING_PAY, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED',
    ALLIANCE_CD         VARCHAR(30)     NULL        COMMENT '제휴사 코드',
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    MOD_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    CONSTRAINT PK_TB_CLEAN_CONTRACT PRIMARY KEY (CONTRACT_NO),
    CONSTRAINT FK_CNT_ORD FOREIGN KEY (ORDER_NO) REFERENCES TB_ORDER_MSTR (ORDER_NO),
    CONSTRAINT FK_CNT_DTL FOREIGN KEY (ORDER_DTL_NO) REFERENCES TB_ORDER_DTL (ORDER_DTL_NO),
    CONSTRAINT FK_CNT_CLIENT FOREIGN KEY (CLIENT_USER_NO) REFERENCES TB_USER (USER_NO),
    CONSTRAINT FK_CNT_SERVICE FOREIGN KEY (SERVICE_USER_NO) REFERENCES TB_USER (USER_NO),
    CONSTRAINT FK_CNT_APPLY FOREIGN KEY (APPLY_NO) REFERENCES TB_QUOTE_APPLY (APPLY_NO)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='청소 체결 계약 마스터';

DROP TABLE IF EXISTS TB_ALLIANCE_COMPANY;
CREATE TABLE TB_ALLIANCE_COMPANY (
    ALLIANCE_CD         VARCHAR(30)     NOT NULL    COMMENT '제휴사 코드 PK (예: AL_APT_01)',
    COMPANY_NM          VARCHAR(100)    NOT NULL    COMMENT '제휴사 상호명',
    BIZ_NO              VARCHAR(20)     NOT NULL    COMMENT '제휴사 사업자번호',
    REP_NM              VARCHAR(50)     NOT NULL    COMMENT '대표자명',
    SETTLE_BANK_CD      VARCHAR(20)     NOT NULL    COMMENT '정산 은행 코드',
    SETTLE_ACNT_NO      VARCHAR(50)     NOT NULL    COMMENT '정산 계좌번호',
    SETTLE_ACNT_HOLDER  VARCHAR(50)     NOT NULL    COMMENT '예금주명',
    COMMISSION_TYPE_CD  VARCHAR(20)     NOT NULL DEFAULT 'RATE' COMMENT 'RATE(순익 요율%), FIXED_AMT(건당 정액)',
    COMMISSION_VAL      DECIMAL(10, 2)  NOT NULL    COMMENT '수수료 요율(예: 15.00) 또는 건당 금액(3000)',
    CONTRACT_START_DT   DATE            NOT NULL    COMMENT '제휴 시작일',
    CONTRACT_END_DT     DATE            NOT NULL    COMMENT '제휴 종료일',
    ACTIVE_YN           CHAR(1)         NOT NULL DEFAULT 'Y' COMMENT '제휴 활성 여부',
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    REG_ID              VARCHAR(50)     NOT NULL DEFAULT 'ADMIN',
    CONSTRAINT PK_TB_ALLIANCE_COMPANY PRIMARY KEY (ALLIANCE_CD)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='플랫폼 외부 제휴사 마스터';

DROP TABLE IF EXISTS TB_ALLIANCE_SETTLE_DTL;
CREATE TABLE TB_ALLIANCE_SETTLE_DTL (
    SETTLE_SEQ          BIGINT AUTO_INCREMENT NOT NULL COMMENT '정산 상세 SEQ PK',
    SETTLE_YM           CHAR(6)         NOT NULL    COMMENT '정산 마감 년월 (YYYYMM)',
    ALLIANCE_CD         VARCHAR(30)     NOT NULL    COMMENT '제휴사 코드 (FK)',
    CONTRACT_NO         CHAR(16)        NOT NULL    COMMENT '체결 계약번호 (FK)',
    TOTAL_SERVICE_AMT   INT             NOT NULL    COMMENT '청소 거래 대금',
    COLLECTED_TOTAL_FEE INT             NOT NULL    COMMENT '수납된 데이터 이용료 총액',
    FIXED_EXPENSE_AMT   INT             NOT NULL DEFAULT 5000 COMMENT '건당 고정경비 (5,000원 공제)',
    NET_PLATFORM_PROFIT INT             NOT NULL    COMMENT '플랫폼 순익 (이용료총액 - 5,000원)',
    ALLIANCE_COMM_AMT   INT             NOT NULL    COMMENT '제휴사 정산 지급액 (수수료)',
    SETTLE_STAT_CD      VARCHAR(20)     NOT NULL DEFAULT 'ACCUMULATED' COMMENT 'ACCUMULATED, CLOSED, TRANSFERRED',
    SETTLED_DT          DATETIME        NULL        COMMENT '정산 확정 일시',
    TRANSFERRED_DT      DATETIME        NULL        COMMENT '실제 계좌 이체 완료 일시',
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT PK_TB_ALLIANCE_SETTLE_DTL PRIMARY KEY (SETTLE_SEQ),
    CONSTRAINT FK_SETTLE_ALLIANCE FOREIGN KEY (ALLIANCE_CD) REFERENCES TB_ALLIANCE_COMPANY (ALLIANCE_CD),
    CONSTRAINT FK_SETTLE_CONTRACT FOREIGN KEY (CONTRACT_NO) REFERENCES TB_CLEAN_CONTRACT (CONTRACT_NO)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='제휴사별 거래 정보 이용료 정산 내역 원장';

TB_COM_CODE_GRP, TB_COM_CODE_GRP

-- ==============================================================================
-- 3. 공통 코드 그룹 마스터 (TB_COM_CODE_GRP) 데이터 일괄 등록
-- ==============================================================================
