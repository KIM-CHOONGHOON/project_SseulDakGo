-- 1. TB_USER 테이블에 서명 이미지 URL 컬럼 추가
ALTER TABLE TB_USER 
ADD COLUMN SIGN_IMG_URL VARCHAR(500) NULL 
COMMENT '전자거래 서명패드 자필 전자서명 이미지 파일 웹 접근 URL' 
AFTER USER_TEL;

-- 2. TB_TERMS_MASTER (약관 마스터 테이블 신규 생성)
CREATE TABLE IF NOT EXISTS TB_TERMS_MASTER (
    TERMS_CD            VARCHAR(30)     NOT NULL    COMMENT '약관 구분 코드 (SERVICE, PRIVACY, LOCATION, FINANCE, SIGNATURE, MARKETING)',
    TERMS_VER           VARCHAR(20)     NOT NULL    COMMENT '약관 버전 (예: v1.0)',
    TERMS_TITLE         VARCHAR(150)    NOT NULL    COMMENT '약관 명칭',
    TERMS_CONTENT       LONGTEXT        NOT NULL    COMMENT '약관 상세 본문 내용',
    MANDATORY_YN        CHAR(1)         NOT NULL DEFAULT 'Y' COMMENT '필수 동의 여부 (Y: 필수, N: 선택)',
    EFFECTIVE_DT        DATE            NOT NULL    COMMENT '약관 발효 시행 일자',
    USE_YN              CHAR(1)         NOT NULL DEFAULT 'Y' COMMENT '현재 사용 여부 (Y/N)',
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    REG_ID              VARCHAR(50)     NOT NULL DEFAULT 'SYSTEM',
    MOD_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    MOD_ID              VARCHAR(50)     NOT NULL DEFAULT 'SYSTEM',
    CONSTRAINT PK_TB_TERMS_MASTER PRIMARY KEY (TERMS_CD, TERMS_VER)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='이용약관 마스터 테이블';

-- 3. TB_TERMS_AGREE_SIGN (약관별 동의 일시 및 서명 증적 관리 테이블 신규 생성)
CREATE TABLE IF NOT EXISTS TB_TERMS_AGREE_SIGN (
    AGREE_SEQ           BIGINT AUTO_INCREMENT NOT NULL COMMENT '동의 및 서명 이력 일련번호 PK',
    USER_ROLE_CD        CHAR(1)         NOT NULL    COMMENT '회원 구분 (C: 고객, S: 시공사)',
    USER_NO             CHAR(12)        NOT NULL    COMMENT '회원 식별번호 (TB_USER 외래키)',
    TERMS_CD            VARCHAR(30)     NOT NULL    COMMENT '약관 구분 코드 (SERVICE, PRIVACY, LOCATION, FINANCE, SIGNATURE, MARKETING)',
    TERMS_VER           VARCHAR(20)     NOT NULL DEFAULT 'v1.0' COMMENT '약관 버전',
    AGREE_YN            CHAR(1)         NOT NULL DEFAULT 'Y' COMMENT '동의 여부 (Y: 동의, N: 미동의)',
    AGREE_DT            DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '약관별 동의 일자 및 시간',
    SIGN_FILE_NM        VARCHAR(255)    NULL        COMMENT '서명 PNG 파일명 (예: sign_C20261000001_1793380000000.png)',
    SIGN_FILE_PATH      VARCHAR(500)    NULL        COMMENT '서버 상의 물리 저장 디렉토리 절대/상대 경로 (예: public/uploads/signatures/...)',
    SIGN_FILE_URL       VARCHAR(500)    NULL        COMMENT '서명 이미지 웹 접근 URL (예: /uploads/signatures/...)',
    CLIENT_IP           VARCHAR(50)     NULL        COMMENT '동의 당시 접속 클라이언트 IP 주소',
    DEVICE_INFO         VARCHAR(255)    NULL        COMMENT '접속 기기 정보 (User-Agent 등)',
    REG_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP,
    REG_ID              VARCHAR(50)     NOT NULL    COMMENT '최초 등록자 (USER_NO)',
    MOD_DT              DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    MOD_ID              VARCHAR(50)     NOT NULL    COMMENT '최종 수정자 (USER_NO)',
    CONSTRAINT PK_TB_TERMS_AGREE_SIGN PRIMARY KEY (AGREE_SEQ),
    CONSTRAINT FK_TERMS_AGREE_USER FOREIGN KEY (USER_NO) REFERENCES TB_USER (USER_NO) ON DELETE CASCADE,
    INDEX IX_USER_TERMS_AGREE (USER_NO, TERMS_CD, TERMS_VER),
    INDEX IX_AGREE_DT (AGREE_DT)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='회원별 약관 동의 일시 및 자필 전자서명 증적 파일 관리 테이블';

-- 4. 필수 4대 약관 및 전자서명 기본 약관 시드 데이터 등록
INSERT INTO TB_TERMS_MASTER (TERMS_CD, TERMS_VER, TERMS_TITLE, TERMS_CONTENT, MANDATORY_YN, EFFECTIVE_DT, USE_YN)
VALUES 
(
  'SERVICE', 'v1.0', '서비스 통합이용약관', 
  '제1조 (목적 및 플랫폼 매칭비 확정 규정)\n본 약관은 주식회사 쓸고닦고(이하 회사가 운영하는 O2O 주거위생 안심 매칭 서비스의 기본 이용조건을 규정합니다.\n제2조 (현장 시공비 직불 원칙 및 안심 시공 책임)\n시공 노임 및 인건비는 시공 검수 완료 후 고객이 시공 마스터에게 직접 지급함을 원칙으로 합니다.\n제3조 (역경매 및 덤핑 금지)\n플랫폼의 표준 단가 체계를 왜곡하는 불공정 덤핑 제안은 즉각적인 계정 정지 사유가 됩니다.',
  'Y', '2026-01-01', 'Y'
),
(
  'PRIVACY', 'v1.0', '개인정보 수집 및 이용 동의', 
  '1. 수집 항목 및 보유 목적\n- 필수 수집 항목: 성명, 휴대전화번호, 이메일 주소, 서비스 시공 희망 주소지.\n2. 보유 및 파기 절차\n회원 탈퇴 시 관계 법령에 따라 전자상거래 계약 및 결제 기록은 5년간 보관 후 영구 파기합니다.',
  'Y', '2026-01-01', 'Y'
),
(
  'LOCATION', 'v1.0', '위치기반 서비스 이용약관', 
  '제1조 (위치정보의 활용)\n회사는 신청인의 신청 주소지를 기반으로 가장 신속하게 현장 도달이 가능한 반경 5km 이내의 검증된 마스터를 매칭 후보로 제안합니다.\n제2조 (위치기반 출동 관제)\n수집된 GPS 정보는 작업 완료 24시간 후 완전히 마스킹 폐기 처리됩니다.',
  'Y', '2026-01-01', 'Y'
),
(
  'FINANCE', 'v1.0', '전자금융거래 기본약관', 
  '제1조 (결제 대행 및 환불 방침)\n매칭 수수료(16,500원) 결제는 공인 PG사를 통해 진행되며 매칭 실패 시 100% 즉시 자동 환불됩니다.\n제2조 (3개월 안심보증 케어 연동)\n정상 완료된 거래 건에 한하여 90일간 안심보증 분쟁조정위원회의 지원을 받으실 수 있습니다.',
  'Y', '2026-01-01', 'Y'
),
(
  'SIGNATURE', 'v1.0', '전자거래 및 자필 전자서명 보증 동의', 
  '제1조 (전자서명의 법적 효력)\n회원이 서명패드에 자필로 날인한 전자서명은 전자서명법 제3조에 의거하여 종이 문서에 날인한 자필 서명 또는 인감 날인과 동일한 법적 효력을 가집니다.\n제2조 (서명 원본의 보관)\n체결된 전자서명 이미지 파일 원본 및 메타데이터는 공증용 증적 데이터베이스에 영구 보관됩니다.',
  'Y', '2026-01-01', 'Y'
)
ON DUPLICATE KEY UPDATE 
  TERMS_TITLE = VALUES(TERMS_TITLE),
  TERMS_CONTENT = VALUES(TERMS_CONTENT),
  MANDATORY_YN = VALUES(MANDATORY_YN);

SET FOREIGN_KEY_CHECKS = 1;


================================================================================
6. WEB 화면 목록 및 기능 상세 명세서 (개정 접두사: WEB-)
================================================================================

[고객 영역 : Domain: Client / Role: C]
1. 화면 ID: WEB-CLNT-COM-000 | 구분: Main 화면
   - 화면명: 고객 메인 홈
   - URL: https://sseuldakgo.kr/client/
   - 관련 테이블: TB_USER, TB_ORDER_MSTR, TB_ORDER_DTL, TB_COM_CODE
   - 개요: 3대 청소 선택 카드 및 실시간 접수 피드 표출, '+ 우리 집 청소 요청 등록하기' 터치 시 등록 모달(WEB-CLNT-REQ-000) 호출.
2. 화면 ID: WEB-CLNT-REQ-000 | 구분: Sub 화면 (모달)
   - 화면명: 청소 서비스 신청 (청소 요청 등록)
   - URL: /client/ (모달 오버레이)
   - 관련 테이블: TB_ORDER_MSTR, TB_ORDER_DTL, TB_ORDER_PHOTO, TB_COM_CODE
   - 개요: 3대 TAB([정기청소] | [입주청소] | [계절가전]), 의뢰 기본정보(업체명, 담당자명, 연락처 등), 시설유형, 주차여부, 고객 확정 지정가 입력, 비회원 작성 시 LocalStorage 임시 저장 후 로그인 모달 호출.
3. 화면 ID: WEB-CLNT-REQ-001 | 구분: Sub 화면 (모달)
   - 화면명: 현장 도로명 주소 검색
   - URL: /client/ (주소 팝업)
   - 관련 테이블: TB_COM_CODE
   - 개요: 행안부 도로명 주소 연계 및 시도/시군구 코드 부모창 자동 매핑.
4. 화면 ID: WEB-CLNT-ATH-000 | 구분: Sub 화면 (모달)
   - 화면명: 고객 로그인
   - URL: /client/ (로그인 모달)
   - 관련 테이블: TB_USER
   - 개요: 회원구분(고객 기본), 아이디 저장(C 구분자 보존), 소셜/이메일 로그인, 로그인 성공 시 임시 저장된 청소 요청 데이터 100% 자동 조립(Pre-fill) 복원.
5. 화면 ID: WEB-CLNT-ATH-010 | 구분: Sub 화면 (모달)
   - 화면명: 통합 회원가입 및 4대 약관 정독
   - URL: /client/ (가입 모달)
   - 관련 테이블: TB_USER, TB_TERMS_MASTER, TB_TERMS_VERSION, TB_TERMS_AGREE_SIGN
   - 개요: 고객/용역 세그먼트 선택, PASS/SMS 본인확인, 4대 약관 전문 스크롤 100% 도달 시 동의 활성화, 가입 완료 시 채번 공식(C+YYYYMM+5자리) 적용.
6. 화면 ID: WEB-CLNT-ATH-011 | 구분: Sub 화면 (모달)
   - 화면명: 고객 가입 완료 환영 안내
   - URL: /client/ (완료 팝업)
   - 관련 테이블: TB_USER
   - 개요: 고객 가입 축하 및 즉시 청소 요청 등록 모달 유도.
7. 화면 ID: WEB-CLNT-ORD-000 | 구분: Main 화면
   - 화면명: 나의 청소 신청 현황
   - URL: https://sseuldakgo.kr/client/order/list
   - 관련 테이블: TB_ORDER_MSTR, TB_ORDER_DTL, TB_QUOTE_APPLY, TB_USER
   - 개요: 발주 오더 라이프사이클 목록, 7일 청약 만료 타이머 표출.
8. 화면 ID: WEB-CLNT-ORD-001 | 구분: Sub 화면
   - 화면명: 청소 요청 상세 및 용역 청약서 비교/선택
   - URL: https://sseuldakgo.kr/client/order/detail
   - 관련 테이블: TB_ORDER_MSTR, TB_ORDER_DTL, TB_QUOTE_APPLY, TB_USER
   - 개요: 접수된 용역들의 제안 일자, 시각(HH:mm), 소요시간, 투입인원 비교 후 최적 1인 최종 선택.
9. 화면 ID: WEB-CLNT-PAY-000 | 구분: Sub 화면 (모달)
   - 화면명: 고객 데이터 이용료 결제 및 배타적 계약 확정
   - URL: /client/order/payment
   - 관련 테이블: TB_ORDER_MSTR, TB_ORDER_DTL, TB_CLEAN_CONTRACT, TB_ALLIANCE_SETTLE_DTL
   - 개요: 16,500원 결제 승인, 주발주 CNTR_CONFIRMED, 선택 중분류 APPR_CONTRACT, 미선택 중분류 WAIT_CLOSED 일괄 자동 마감.
10. 화면 ID: WEB-CLNT-JOB-000 | 구분: Sub 화면
    - 화면명: 청소 시공 검수 및 현장 직불 완료 승인
    - URL: https://sseuldakgo.kr/client/job/inspect
    - 관련 테이블: TB_ORDER_MSTR, TB_ORDER_DTL, TB_ORDER_PHOTO, TB_CLEAN_CONTRACT
    - 개요: 시공 전/후 사진 열람, 검수 완료 승인(SVC_COMPLETED) 및 확정 대금 현장 직불 안내.

[용역 영역 : Domain: Service / Role: S]
1. 화면 ID: WEB-SRVC-MAIN-000 | 구분: Main 화면
   - 화면명: 용역 서비스 메인 홈
   - URL: https://sseuldakgo.kr/service/
   - 관련 테이블: TB_USER, TB_ORDER_MSTR, TB_ORDER_DTL, TB_QUOTE_APPLY
   - 개요: 신규 발주 건수([정기 N건] | [입주 N건] | [가전 N건]), 활동 지표, 영업 On/Off 토글, 비회원 공고 탐색 지원.
2. 화면 ID: WEB-SRVC-ATH-000 | 구분: Sub 화면 (모달)
   - 화면명: 용역 서비스 로그인
   - URL: /service/ (로그인 모달)
   - 관련 테이블: TB_USER
   - 개요: 용역 로그인, 아이디 저장(S 구분자 보존), 로그인 성공 시 임시 저장된 청약 대상 정보 자동 복원.
3. 화면 ID: WEB-SRVC-ATH-001 | 구분: Main 화면
   - 화면명: 사업자등록증 원본 업로드 및 OCR AI 진위 검증
   - URL: https://sseuldakgo.kr/service/join/verify
   - 관련 테이블: TB_USER, TB_SERVICE_DOC
   - 개요: 원본 파일/촬영 업로드, CLOVA OCR 자동 파싱, 국세청 API 및 대표자 본인확인 3자 교차 일치 검증.
4. 화면 ID: WEB-SRVC-ATH-002 | 구분: Main 화면
   - 화면명: 용역 위탁계약서 및 전자서명
   - URL: https://sseuldakgo.kr/service/join/contract
   - 관련 테이블: TB_USER, TB_TERMS_MASTER, TB_TERMS_VERSION, TB_TERMS_AGREE_SIGN
   - 개요: 위탁계약서 확인 및 캔버스 자필 전자서명 등록.
5. 화면 ID: WEB-SRVC-ORD-000 | 구분: Main 화면
   - 화면명: 실시간 청소 발주 공고 목록
   - URL: https://sseuldakgo.kr/service/order/list
   - 관련 테이블: TB_ORDER_MSTR, TB_ORDER_DTL, TB_SERVICE_REGION, TB_COM_CODE
   - 개요: 용역 활동 설정 지역(최대 10개) 내 청약 접수 중(BID_OPEN)인 공고 리스트.
6. 화면 ID: WEB-SRVC-ORD-001 | 구분: Sub 화면 (모달)
   - 화면명: 청소 발주 상세 정보
   - URL: /service/order/detail
   - 관련 테이블: TB_ORDER_MSTR, TB_ORDER_DTL, TB_ORDER_PHOTO, TB_COM_CODE
   - 개요: 고객 확정 지정 대금 확인(역경매 불가), 비회원 청약 터치 시 임시 저장 후 로그인 모달 유도.
7. 화면 ID: WEB-SRVC-QOT-000 | 구분: Sub 화면 (모달)
   - 화면명: 청약서 작성 및 방문 일정 제안
   - URL: /service/order/apply
   - 관련 테이블: TB_ORDER_MSTR, TB_ORDER_DTL, TB_QUOTE_APPLY, TB_USER
   - 개요: 고객 확정가 100% 수락, From-To 기간 내 방문일자, 시각(HH:mm), 소요시간 입력, 자전거래 및 일정 중복 충돌 차단 검증.
8. 화면 ID: WEB-SRVC-JOB-000 | 구분: Main 화면
   - 화면명: 시공 작업 관리 및 캘린더
   - URL: https://sseuldakgo.kr/service/job/schedule
   - 관련 테이블: TB_CLEAN_CONTRACT, TB_ORDER_MSTR, TB_ORDER_DTL, TB_USER
   - 개요: 확정 시공 캘린더, 고객 안심번호 확인, [출발하기]->[작업시작]->[결과보고].
9. 화면 ID: WEB-SRVC-JOB-001 | 구분: Sub 화면
   - 화면명: 시공 전/후 사진 등록 및 검수 요청
   - URL: https://sseuldakgo.kr/service/job/report
   - 관련 테이블: TB_ORDER_MSTR, TB_ORDER_DTL, TB_ORDER_PHOTO, TB_CLEAN_CONTRACT
   - 개요: 서비스별 물리 폴더(/orders/{ORDER_NO}/...) 사진 업로드 및 검수 요청 전송.
10. 화면 ID: WEB-SRVC-SET-000 | 구분: Main 화면
    - 화면명: 용역 정산 및 활동 지역 설정
    - URL: https://sseuldakgo.kr/service/setting/profile
    - 관련 테이블: TB_USER, TB_SERVICE_REGION, TB_CLEAN_CONTRACT
    - 개요: 활동 지역 설정(최대 10개 엄격 제한 통제), 직불 수령 및 이용료 납부 내역 조회.

[관리 영역 : Domain: Admin / Role: A]
1. 화면 ID: WEB-ADMN-DSH-000 | 구분: Main 화면
   - 화면명: 전국 종합 관제 대시보드
   - URL: https://sseuldakgo.kr/admin/
   - 관련 테이블: TB_ORDER_MSTR, TB_ORDER_DTL, TB_CLEAN_CONTRACT, TB_USER
   - 개요: 거래액, 순익, 전국 버블맵 관제, 긴급 분쟁 및 심사 큐 표출.
2. 화면 ID: WEB-ADMN-ATH-000 | 구분: Main 화면
   - 화면명: 관리자 보안 로그인
   - URL: https://sseuldakgo.kr/admin/login
   - 관련 테이블: TB_USER
   - 개요: 사원 ID, 비밀번호 및 Google Authenticator OTP 2차 인증.
3. 화면 ID: WEB-ADMN-ORD-000 | 구분: Main 화면
   - 화면명: 청소 발주 및 계약 체결 관제
   - URL: https://sseuldakgo.kr/admin/order/manage
   - 관련 테이블: TB_ORDER_MSTR, TB_ORDER_DTL, TB_QUOTE_APPLY, TB_CLEAN_CONTRACT
   - 개요: 발주 모니터링, 7일 만료 처리 추적, 배타적 계약 확정 검증.
4. 화면 ID: WEB-ADMN-ALC-000 | 구분: Main 화면
   - 화면명: 외부 플랫폼 제휴 및 정보이용료 정산 관제
   - URL: https://sseuldakgo.kr/admin/alliance/settle
   - 관련 테이블: TB_ALLIANCE_COMPANY, TB_ALLIANCE_SETTLE_DTL, TB_CLEAN_CONTRACT
   - 개요: 제휴사별 유입 건수, 플랫폼 순익, 배분 수수료 정산 및 마감 확정.
5. 화면 ID: WEB-ADMN-ALC-001 | 구분: Sub 화면 (모달)
   - 화면명: 제휴 거래 상세 내역 및 정산 산출 근거
   - URL: /admin/alliance/settle/detail
