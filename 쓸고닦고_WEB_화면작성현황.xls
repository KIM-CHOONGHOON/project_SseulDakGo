   </Row>
   <Row><Cell ss:StyleID="sCenter"><Data ss:Type="String">1. 고객 영역 (Client)</Data></Cell><Cell ss:StyleID="sCenter"><Data ss:Type="Number">10</Data></Cell><Cell ss:StyleID="sCenter"><Data ss:Type="Number">9</Data></Cell><Cell ss:StyleID="sCenter"><Data ss:Type="Number">1</Data></Cell><Cell ss:StyleID="sCenter"><Data ss:Type="String">90.0%</Data></Cell></Row>
