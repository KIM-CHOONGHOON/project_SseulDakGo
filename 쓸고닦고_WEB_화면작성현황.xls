   <Row ss:Height="24"><Cell ss:StyleID="sTotal"><Data ss:Type="String">합계</Data></Cell><Cell ss:StyleID="sTotal"><Data ss:Type="Number">28</Data></Cell><Cell ss:StyleID="sTotal"><Data ss:Type="Number">9</Data></Cell><Cell ss:StyleID="sTotal"><Data ss:Type="Number">19</Data></Cell><Cell ss:StyleID="sTotal"><Data ss:Type="String">32.1%</Data></Cell></Row>
